    {
        "id": "02b8f52c8ace7f64",
        "type": "function",
        "z": "e2c30af31cf0196c",
        "name": "Simpan Threshold",
        "func": "var batas = Number(msg.payload.threshold);\n\nif (!Number.isFinite(batas) || batas <= 0) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: \"error\",\n        message: \"Batas suhu harus berupa angka lebih dari 0\"\n    };\n    return msg;\n}\n\nflow.set(\"batas_suhu\", batas);\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: \"success\",\n    message: \"Batas suhu berhasil diatur\",\n    threshold: batas\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
