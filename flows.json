    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "e2c30af31cf0196c",
        "name": "Validasi & Publish",
        "func": "var body = msg.payload;\n\nif (typeof body === \"string\") {\n    body = JSON.parse(body);\n}\n\n// Header CORS untuk respons\nmsg.headers = {\n    'Access-Control-Allow-Origin': '*',\n    'Access-Control-Allow-Methods': 'GET, POST, PUT, OPTIONS',\n    'Access-Control-Allow-Headers': 'Content-Type, X-API-Key'\n};\n\n// Validasi data\nif (!body || !body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = {\n        status: 'error',\n        message: 'device dan action wajib diisi'\n    };\n\n    return [msg, null];\n}\n\n// Pesan untuk MQTT\nvar mqttMsg = {\n    topic: 'iot/kontrol',\n    payload: body\n};\n\n// Respons HTTP\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    message: 'Perintah terkirim',\n    sent: body\n};\n\n// Output 1 = HTTP Response\n// Output 2 = MQTT Publish\nreturn [msg, mqttMsg];\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 440,
        "wires": [
            [
                "http_resp_kontrol"
            ],
            [
                "mqtt_publish_kontrol"
            ]
        ]
